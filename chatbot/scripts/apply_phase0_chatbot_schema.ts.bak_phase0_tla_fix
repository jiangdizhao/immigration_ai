import { config } from "dotenv";
import postgres from "postgres";

config({ path: ".env.local" });

const databaseUrl = process.env.POSTGRES_URL;

if (!databaseUrl) {
  throw new Error("POSTGRES_URL is not defined in chatbot/.env.local");
}

const sql = postgres(databaseUrl, { max: 1 });

try {
  await sql.unsafe(`CREATE TABLE IF NOT EXISTS "ImmigrationConversation" (
    "chatId" uuid PRIMARY KEY NOT NULL,
    "legalMatterId" varchar(255),
    "title" text,
    "createdAt" timestamp NOT NULL,
    "updatedAt" timestamp NOT NULL,
    CONSTRAINT "ImmigrationConversation_chatId_Chat_id_fk"
      FOREIGN KEY ("chatId") REFERENCES "public"."Chat"("id")
      ON DELETE cascade ON UPDATE no action
  );`);

  await sql.unsafe(`CREATE INDEX IF NOT EXISTS "ix_immigration_conversation_legal_matter_id"
    ON "ImmigrationConversation" ("legalMatterId");`);

  console.log("Phase 0 chatbot schema is present.");
} finally {
  await sql.end();
}
