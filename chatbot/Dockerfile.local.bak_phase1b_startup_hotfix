# Phase 1B local production-simulation Dockerfile for the Next.js chatbot.
# Build context must be the repository root.

FROM node:22-bookworm-slim AS app

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable

COPY chatbot/package.json chatbot/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY chatbot/ ./
RUN pnpm build

EXPOSE 3000

CMD ["sh", "-c", "pnpm db:migrate && npx tsx scripts/apply-phase0-chatbot-schema.ts && pnpm start -- -H 0.0.0.0 -p 3000"]
