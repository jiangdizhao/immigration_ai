# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on Vercel

# Instructions to create an AI Gateway API key here: https://vercel.com/ai-gateway 
# API key required for non-Vercel deployments
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/postgres
POSTGRES_URL=****

# Account email delivery. The SES provider uses the ECS task role in deployed environments.
EMAIL_PROVIDER=ses
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Au Lawyers
APP_BASE_URL=http://localhost:3000
AWS_REGION=ap-southeast-2

# M2 local-only simulated VIP checkout. Keep disabled outside explicit local/test use.
VIP_PAYMENT_PROVIDER=simulation
VIP_SIMULATED_PAYMENT_ENABLED=false
VIP_PRICE_MINOR=9900
VIP_DURATION_DAYS=30

# Phase 9 recurring VIP billing (M1 foundation). Production must use "stripe".
# Simulation requires an explicit non-production opt-in and never runs in production.
VIP_BILLING_PROVIDER=
VIP_BILLING_SIMULATION_ENABLED=false
# Server-only Stripe secret key. Never expose to the browser or commit a real value.
STRIPE_SECRET_KEY=
# Server-only Stripe webhook signing secret (required for the billing webhook endpoint).
STRIPE_WEBHOOK_SECRET=


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Server-only lawyer supervision assertion; never expose to browser code.
LAWYER_REVIEW_ASSERTION_SECRET=****
