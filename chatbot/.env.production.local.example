# Local production simulation example for chatbot.
# Copy values manually into your real .env.local if needed. Do not commit real env files.

NODE_ENV=production
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-local-production-test-secret
POSTGRES_URL=postgres://postgres:1225@localhost:5432/chatbot

LEGAL_SERVICE_URL=http://127.0.0.1:8000
LEGAL_SERVICE_API_KEY=replace-with-same-key-as-legal-service
LAWYER_REVIEW_TOKEN=replace-with-local-review-token

NEXT_PUBLIC_WIDGET_DEBUG=false
