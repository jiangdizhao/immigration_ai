# Build context: repository root. The base image platform follows the selected
# build target; Stage 4 must select the actual ECS architecture explicitly.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN corepack enable
COPY chatbot/package.json chatbot/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY --from=dependencies /app/node_modules ./node_modules
COPY chatbot/ ./
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_WIDGET_DEBUG=false
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
COPY --from=build /app/lib/matter-documents/processing/worker-runtime ./lib/matter-documents/processing/worker-runtime
COPY --from=build /app/scripts/verify-native-runtime.mjs ./scripts/verify-native-runtime.mjs
COPY --from=build /app/lib/production/native-runtime-verifier.mjs ./lib/production/native-runtime-verifier.mjs
EXPOSE 3000
CMD ["node", "server.js"]
