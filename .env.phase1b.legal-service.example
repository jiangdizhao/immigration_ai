# Phase 1B local container simulation env for legal-service.
# Copy to .env.phase1b.legal-service.local and edit locally.
# Never commit the .local file.

APP_ENV=production
AUTO_CREATE_SCHEMA=false
APP_PORT=8000
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://immigration_local:local_phase1b_password@phase1b-postgres:5432/immigration_legal
LEGAL_SERVICE_API_KEY=replace-with-legal-service-api-key
LAWYER_REVIEW_ASSERTION_SECRET=replace-with-independent-server-assertion-secret
ALLOWED_ORIGINS=http://localhost:3000

OPENAI_API_KEY=replace-locally-only
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SECONDS=20

# Premium Direct quick-answer lane. Search is available but optional; both
# provider clients use zero SDK retries and share one 45-second lane budget.
PREMIUM_DIRECT_PRIMARY_MODEL=gpt-5.6-sol
PREMIUM_DIRECT_PRIMARY_REASONING_EFFORT=high
PREMIUM_DIRECT_PRIMARY_TIMEOUT_SECONDS=50
PREMIUM_DIRECT_PRIMARY_MAX_RETRIES=0
PREMIUM_DIRECT_FALLBACK_MODEL=gpt-5.6-luna
PREMIUM_DIRECT_FALLBACK_REASONING_EFFORT=medium
PREMIUM_DIRECT_FALLBACK_TIMEOUT_SECONDS=55
PREMIUM_DIRECT_FALLBACK_MAX_RETRIES=0
PREMIUM_DIRECT_WEB_SEARCH_ENABLED=true
PREMIUM_DIRECT_WEB_SEARCH_REQUIRED=false
PREMIUM_DIRECT_WEB_SEARCH_CONTEXT_SIZE=high
PREMIUM_DIRECT_MAX_TOOL_CALLS=3
PREMIUM_DIRECT_LANE_BUDGET_MS=45000
PREMIUM_DIRECT_MIN_FALLBACK_BUDGET_MS=1000

ENABLE_LAWYER_REVIEW_TRACE=true
PHASE7_EXPERIENCE_ARCHIVE_ENABLED=false

# v2.1.1 Phase 2. The legacy serving engine remains authoritative; the
# deterministic FastAPI political fail-safe is active before it.
ANSWER_ENGINE=v1
DEFAULT_AGENT_MODEL=gpt-5.6-luna
# Phase 5.1A: explicit GPT-5.6 Luna reasoning effort (none|low|medium|high).
# Current revised-Default calibration baseline is low.
DEFAULT_AGENT_REASONING_EFFORT=low
PREMIUM_AGENT_MODEL=gpt-5.6-sol
LEGAL_FACT_CHECK_MODEL=gpt-5.6-luna
AGENT_TOOL_CHOICE=auto
AGENT_MAX_TOOL_ROUNDS=2
AGENT_MAX_PROVIDER_CALLS=3
AGENT_MAX_RETRIES=1
# Phase 5 resource governance
AGENT_MAX_FLAT_RAG_CALLS=1
AGENT_RETRY_VIABILITY_THRESHOLD_MS=8000
DEFAULT_TURN_DEADLINE_MS=40000
PREMIUM_TURN_DEADLINE_MS=45000
DEFAULT_ANSWER_RESEARCH_TARGET_MS=32000
PREMIUM_ANSWER_RESEARCH_TARGET_MS=37000
LEGAL_FACT_CHECK_TARGET_MS=8000
LEGAL_EVIDENCE_POSTCONDITION_ENABLED=true

# No v2.1.1 agent/model/tool runtime is active in Phase 1.
WEB_SEARCH_ENABLED=false
EXACT_LEGAL_LOOKUP_ENABLED=false
LIGHTRAG_ENABLED=false
LIGHTRAG_STORAGE_PROFILE=
FLAT_RAG_TOOL_ENABLED=false
COMPACT_MATTER_STATE_ENABLED=false
BACKEND_POLITICAL_FAILSAFE_ENABLED=true
DEFAULT_AGENT_SERVING_ENABLED=false
AGENT_SHADOW_ENABLED=false
AGENT_ROLLOUT_PERCENT_DEFAULT=0
AGENT_ROLLOUT_PERCENT_PREMIUM=0
