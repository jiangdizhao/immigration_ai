# Phase 1B local container simulation env for chatbot.
# Copy to .env.phase1b.chatbot.local and edit locally.
# Never commit the .local file.

NODE_ENV=production
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=local-phase1b-auth-secret-change-me

POSTGRES_URL=postgres://immigration_local:local_phase1b_password@phase1b-postgres:5432/chatbot

LEGAL_SERVICE_URL=http://phase1b-legal-service:8000
LEGAL_SERVICE_API_KEY=local-phase1b-dev-key
LAWYER_REVIEW_TOKEN=local-phase1b-review-token
LAWYER_REVIEW_ASSERTION_SECRET=replace-with-independent-server-assertion-secret

REDIS_URL=redis://phase1b-valkey:6379
NEXT_PUBLIC_WIDGET_DEBUG=false
