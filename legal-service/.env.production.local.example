# Local production simulation example for legal-service.
# Copy values manually into your real .env if needed. Do not commit real env files.

APP_ENV=production
AUTO_CREATE_SCHEMA=false
APP_PORT=8000
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://rico_local:1225@localhost:5432/immigration_legal
LEGAL_SERVICE_API_KEY=replace-with-same-key-as-chatbot
ALLOWED_ORIGINS=http://localhost:3000

OPENAI_API_KEY=replace-locally-only
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SECONDS=20

ENABLE_LAWYER_REVIEW_TRACE=true
