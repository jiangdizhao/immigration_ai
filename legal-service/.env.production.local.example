# Local production simulation example for legal-service.
# Copy values manually into your real .env if needed. Do not commit real env files.

APP_ENV=production
AUTO_CREATE_SCHEMA=false
APP_PORT=8000
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://rico_local:1225@localhost:5432/immigration_legal
LEGAL_SERVICE_API_KEY=replace-with-same-key-as-chatbot
ALLOWED_ORIGINS=http://localhost:3000

OPENAI_API_KEY=replace-locally-only
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SECONDS=20

# Direct LLM quick-answer lane. These are model controls only, not secrets.
# It skips the full semantic router/PFVD/RAG helper chain, but keeps lightweight recent chat history.
# Public answer text does not reveal whether the primary or fallback model served the response.
PREMIUM_DIRECT_PRIMARY_MODEL=gpt-5.5
PREMIUM_DIRECT_PRIMARY_REASONING_EFFORT=high
PREMIUM_DIRECT_PRIMARY_TIMEOUT_SECONDS=45
PREMIUM_DIRECT_FALLBACK_MODEL=gpt-5.4-mini
PREMIUM_DIRECT_FALLBACK_REASONING_EFFORT=
PREMIUM_DIRECT_FALLBACK_TIMEOUT_SECONDS=55
PREMIUM_DIRECT_OPENAI_MAX_RETRIES=0
PREMIUM_DIRECT_MAX_HISTORY_TURNS=6
PREMIUM_DIRECT_MAX_HISTORY_CHARS_PER_TURN=700
PREMIUM_DIRECT_MAX_HISTORY_TOTAL_CHARS=3000

ENABLE_LAWYER_REVIEW_TRACE=true
