# Local production simulation example for legal-service.
# Copy values manually into your real .env if needed. Do not commit real env files.

APP_ENV=production
AUTO_CREATE_SCHEMA=false
APP_PORT=8000
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://rico_local:1225@localhost:5432/immigration_legal
LEGAL_SERVICE_API_KEY=replace-with-same-key-as-chatbot
LAWYER_REVIEW_ASSERTION_SECRET=replace-with-independent-server-assertion-secret
ALLOWED_ORIGINS=http://localhost:3000

OPENAI_API_KEY=replace-locally-only
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SECONDS=20

# Direct LLM quick-answer lane. These are model controls only, not secrets.
# It skips the full semantic router/PFVD/RAG helper chain, but keeps lightweight recent chat history.
# Public answer text does not reveal whether the primary or fallback model served the response.
PREMIUM_DIRECT_PRIMARY_MODEL=gpt-5.6-sol
PREMIUM_DIRECT_PRIMARY_REASONING_EFFORT=high
PREMIUM_DIRECT_PRIMARY_TIMEOUT_SECONDS=50
PREMIUM_DIRECT_PRIMARY_MAX_RETRIES=0
PREMIUM_DIRECT_FALLBACK_MODEL=gpt-5.6-luna
PREMIUM_DIRECT_FALLBACK_REASONING_EFFORT=medium
PREMIUM_DIRECT_FALLBACK_TIMEOUT_SECONDS=55
PREMIUM_DIRECT_FALLBACK_MAX_RETRIES=0
PREMIUM_DIRECT_WEB_SEARCH_ENABLED=true
PREMIUM_DIRECT_WEB_SEARCH_REQUIRED=false
PREMIUM_DIRECT_WEB_SEARCH_CONTEXT_SIZE=high
PREMIUM_DIRECT_MAX_TOOL_CALLS=none
# Premium has a 90-second absolute lane, a non-resetting 65-second research
# window, and a protected terminal synthesis/finalization budget.
PREMIUM_DIRECT_LANE_BUDGET_MS=90000
PREMIUM_DIRECT_RESEARCH_TARGET_MS=65000
PREMIUM_DIRECT_TERMINAL_TARGET_MS=15000
PREMIUM_DIRECT_FINAL_RESPONSE_RESERVE_MS=3000
PREMIUM_DIRECT_TERMINAL_MIN_START_BUDGET_MS=5000
PREMIUM_DIRECT_MIN_FALLBACK_BUDGET_MS=1000
PREMIUM_DIRECT_MAX_HISTORY_TURNS=6
PREMIUM_DIRECT_MAX_HISTORY_CHARS_PER_TURN=700
PREMIUM_DIRECT_MAX_HISTORY_TOTAL_CHARS=3000

ENABLE_LAWYER_REVIEW_TRACE=true
PHASE7_EXPERIENCE_ARCHIVE_ENABLED=false

# v2.1.1 Phase 2. Keep the new answer architecture disabled while the
# deterministic FastAPI political fail-safe remains active.
ANSWER_ENGINE=v1
DEFAULT_AGENT_MODEL=gpt-5.6-luna
# Phase 5.1A: explicit GPT-5.6 Luna reasoning effort (none|low|medium|high).
# Current revised-Default calibration baseline is low.
DEFAULT_AGENT_REASONING_EFFORT=low
PREMIUM_AGENT_MODEL=gpt-5.6-sol
LEGAL_FACT_CHECK_MODEL=gpt-5.6-luna
AGENT_TOOL_CHOICE=auto
AGENT_MAX_TOOL_ROUNDS=2
AGENT_MAX_PROVIDER_CALLS=3
AGENT_MAX_RETRIES=1
# Phase 5 resource governance
AGENT_MAX_FLAT_RAG_CALLS=1
AGENT_RETRY_VIABILITY_THRESHOLD_MS=8000
# Omit DEFAULT_WEB_SEARCH_MAX_TOOL_CALLS for native autonomy; set it to an
# integer such as 2 only for a deliberately capped experiment.
DEFAULT_TURN_DEADLINE_MS=75000
PREMIUM_TURN_DEADLINE_MS=90000
DEFAULT_ANSWER_RESEARCH_TARGET_MS=45000
PREMIUM_ANSWER_RESEARCH_TARGET_MS=65000
LEGAL_FACT_CHECK_TARGET_MS=8000
TERMINAL_SYNTHESIS_TARGET_MS=15000
FINAL_RESPONSE_RESERVE_MS=3000
TERMINAL_SYNTHESIS_MIN_START_BUDGET_MS=5000
DEFAULT_TERMINAL_SYNTHESIS_TARGET_MS=20000
DEFAULT_FINAL_RESPONSE_RESERVE_MS=5000
LEGAL_EVIDENCE_POSTCONDITION_ENABLED=true
WEB_SEARCH_ENABLED=false
EXACT_LEGAL_LOOKUP_ENABLED=false
LIGHTRAG_ENABLED=false
LIGHTRAG_STORAGE_PROFILE=
FLAT_RAG_TOOL_ENABLED=false
COMPACT_MATTER_STATE_ENABLED=false
BACKEND_POLITICAL_FAILSAFE_ENABLED=true
DEFAULT_AGENT_SERVING_ENABLED=false
AGENT_SHADOW_ENABLED=false
AGENT_ROLLOUT_PERCENT_DEFAULT=0
AGENT_ROLLOUT_PERCENT_PREMIUM=0
