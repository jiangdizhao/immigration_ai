@dataclass(slots=True)
class _QueryStageTimer:
    request_id: str
    matter_id: str | None = None
    started_at: float = field(default_factory=time.perf_counter)
    last_at: float = field(default_factory=time.perf_counter)
    stages: list[dict[str, Any]] = field(default_factory=list)

    def mark(self, stage: str, **metadata: Any) -> None:
        now = time.perf_counter()
        duration_ms = (now - self.last_at) * 1000.0
        total_ms = (now - self.started_at) * 1000.0
        row = {
            "stage": stage,
            "duration_ms": round(duration_ms, 1),
            "total_ms": round(total_ms, 1),
        }
        if metadata:
            row["metadata"] = {key: value for key, value in metadata.items() if value is not None}
        self.stages.append(row)
        self.last_at = now
        logger.info(
            "query_stage request_id=%s matter_id=%s stage=%s duration_ms=%.1f total_ms=%.1f",
            self.request_id,
            self.matter_id,
            stage,
            duration_ms,
            total_ms,
        )

    def to_debug_dict(self) -> dict[str, Any]:
        total_ms = (time.perf_counter() - self.started_at) * 1000.0
        return {
            "request_id": self.request_id,
            "matter_id": self.matter_id,
            "total_ms": round(total_ms, 1),
            "stages": list(self.stages),
        }


@dataclass(slots=True)
class _SemanticTaskAction:
    """Task-action adapter derived from SemanticTurnAnalysis.

    It intentionally does not classify natural language. It only adapts the
    already-filled semantic JSON form into the shape expected by the task
    fulfillment service.
    """

    action_type: str = "legal_question"
    should_handle_as_task: bool = False
    task_type: str | None = None
    confidence: str = "low"
    reason: str = ""
    matched_phrases: list[str] = field(default_factory=list)
    accepted_offer: dict[str, Any] | None = None
    semantic_turn: dict[str, Any] | None = None

    def to_debug_dict(self) -> dict[str, Any]:
        return {
            "action_type": self.action_type,
            "should_handle_as_task": self.should_handle_as_task,
            "task_type": self.task_type,
            "confidence": self.confidence,
            "reason": self.reason,
            "matched_phrases": list(self.matched_phrases),
            "accepted_offer": self.accepted_offer,
            "semantic_turn": self.semantic_turn,
            "semantic_regex_used": False,
        }


